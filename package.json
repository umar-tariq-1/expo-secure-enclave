{
  "name": "expo-secure-enclave",
  "version": "0.1.0",
  "description": "Hardware-backed ECDSA P-256 signing for Expo apps: iOS Secure Enclave and Android Keystore/StrongBox, gated by Face ID / Touch ID / biometric prompt.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src",
    "ios",
    "android/build.gradle",
    "android/src/main",
    "app.plugin.js",
    "expo-module.config.json",
    "mock.js",
    "mock.d.ts",
    "llms.txt",
    "CHANGELOG.md",
    "!**/__tests__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "expo",
    "expo-module",
    "react-native",
    "secure-enclave",
    "ios-secure-enclave",
    "hardware-security",
    "hardware-backed",
    "android-keystore",
    "strongbox",
    "biometric",
    "biometric-authentication",
    "face-id",
    "faceid",
    "touch-id",
    "fingerprint",
    "ecdsa",
    "p256",
    "secp256r1",
    "signing",
    "digital-signature",
    "cryptography",
    "key-management",
    "device-binding"
  ],
  "repository": "https://github.com/umar-tariq-1/expo-secure-enclave",
  "bugs": {
    "url": "https://github.com/umar-tariq-1/expo-secure-enclave/issues"
  },
  "author": "Umar Tariq <official.umartariq@gmail.com> (https://github.com/umar-tariq-1)",
  "license": "MIT",
  "homepage": "https://github.com/umar-tariq-1/expo-secure-enclave#readme",
  "dependencies": {
    "@noble/curves": "^2.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.25",
    "expo-modules-core": "~57.0.19",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@noble))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "peerDependencies": {
    "expo": ">=57",
    "react": "*",
    "react-native": "*"
  }
}
